<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Membership_Price_Non_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>Membership_Price__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Membership_Price__c</errorDisplayField>
    <errorMessage>Membership price cannot be negative.</errorMessage>
</ValidationRule>
