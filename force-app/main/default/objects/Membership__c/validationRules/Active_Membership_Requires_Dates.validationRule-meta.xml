<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Membership_Requires_Dates</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Active&quot;),
    OR(  
        ISBLANK(Start_Date__c),
        ISBLANK(End_Date__c)
    )
)</errorConditionFormula>
    <errorMessage>Enter the start date and end date before activating a membership.</errorMessage>
</ValidationRule>
